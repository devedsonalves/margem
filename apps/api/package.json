{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter @margem/database build",
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/main.ts",
    "prebuild": "pnpm --filter @margem/database build",
    "build": "tsc -p tsconfig.json",
    "start": "TS_NODE_BASEURL=./dist node -r tsconfig-paths/register dist/main.js",
    "start:prod": "TS_NODE_BASEURL=./dist node -r tsconfig-paths/register dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration-spec.ts' --exclude '**/*.contract-spec.ts'",
    "test:integration": "vitest run integration-spec --passWithNoTests",
    "test:contract": "vitest run contract-spec --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1050.0",
    "@aws-sdk/s3-request-presigner": "^3.1050.0",
    "@margem/database": "workspace:*",
    "@margem/types": "workspace:*",
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/typeorm": "^11.0.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.3",
    "@types/express": "^4.17.17",
    "@types/node": "^20.0.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^3.15.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11"
  }
}
