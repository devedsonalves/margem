# Database
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=verify-full"
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/margem_test"
DB_POOL_SIZE=10

# Auth
JWT_SECRET="replace-with-a-long-random-secret"

# iDrive e2 / S3
IDRIVE_E2_ACCESS_KEY_ID=""
IDRIVE_E2_SECRET_ACCESS_KEY=""
IDRIVE_E2_ENDPOINT=""
IDRIVE_E2_BUCKET_NAME=""
IDRIVE_E2_REGION=""

# App
PORT=5000
APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:5000"
CORS_ORIGINS="http://localhost:3000"

# Asaas
ASAAS_ENVIRONMENT="sandbox"
ASAAS_API_KEY="$aact_hmlg_replace-with-your-sandbox-key"
ASAAS_CALLBACK_BASE_URL="https://your-public-api-url.example.com"
ASAAS_WEBHOOK_BASE_URL="https://your-public-api-url.example.com"
ASAAS_WEBHOOK_EMAIL="dev@example.com"
ASAAS_WEBHOOK_TOKEN="replace-with-a-32-character-webhook-token"
ASAAS_AUTO_CONFIGURE_WEBHOOK="true"
ASAAS_BILLING_TYPES="CREDIT_CARD"
ASAAS_CHECKOUT_MINUTES_TO_EXPIRE=120
